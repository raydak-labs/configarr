{
  "name": "configarr",
  "version": "0.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/raydak-labs/configarr.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsx esbuild.ts",
    "coverage": "vitest run --coverage",
    "generateApi": "tsx generate-api.ts",
    "lint": "prettier --log-level error --check .",
    "lint:fix": "prettier --list-different --write --log-level error .",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:arr": "vitest run --config vitest.arr-e2e.config.ts",
    "test:e2e:arr:pipeline": "vitest run --config vitest.arr-e2e.config.ts --project pipeline",
    "test:e2e:arr:sonarr-v5": "vitest run --config vitest.arr-e2e.config.ts --project sonarr-v5",
    "test:e2e:arr:radarr": "vitest run --config vitest.arr-e2e.config.ts --project radarr-v5 --project radarr-v7 --project arr tests/arr-e2e/radarr.e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "18.0.9",
    "fast-glob": "3.3.3",
    "ky": "2.2.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "simple-git": "4.0.2",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hyrious/esbuild-plugin-commonjs": "0.2.6",
    "@playwright/test": "1.64.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "release-it": "21.1.2",
    "swagger-typescript-api": "13.13.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
