{
  "name": "configarr",
  "version": "0.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/raydak-labs/configarr.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsx esbuild.ts",
    "coverage": "vitest run --coverage",
    "generateApi": "tsx generate-api.ts",
    "lint": "prettier --log-level error --check .",
    "lint:fix": "prettier --list-different --write --log-level error .",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:arr": "pnpm test:e2e:arr:parallel && pnpm test:e2e:arr:pipeline && pnpm test:e2e:arr:sonarr-v5 && pnpm test:e2e:arr:radarr",
    "test:e2e:arr:parallel": "vitest run --config vitest.arr-e2e.config.ts",
    "test:e2e:arr:pipeline": "vitest run --config vitest.arr-e2e.pipeline.config.ts",
    "test:e2e:arr:sonarr-v5": "SONARR_BASE_URL=\"${SONARR_V5_BASE_URL:-http://127.0.0.1:18990}\" SONARR_API_KEY=\"${SONARR_V5_API_KEY:-e2etestapikey0123456789abcdef012}\" vitest run --config vitest.arr-e2e.config.ts tests/arr-e2e/sonarr.e2e.test.ts",
    "test:e2e:arr:radarr": "pnpm test:e2e:arr:radarr-v5 && pnpm test:e2e:arr:radarr-v6 && pnpm test:e2e:arr:radarr-v7",
    "test:e2e:arr:radarr-v5": "RADARR_BASE_URL=\"${RADARR_V5_BASE_URL:-http://127.0.0.1:17879}\" RADARR_API_KEY=\"${RADARR_V5_API_KEY:-e2etestapikey0123456789abcdef012}\" RADARR_EXPECTED_MAJOR=5 vitest run --config vitest.arr-e2e.radarr.config.ts",
    "test:e2e:arr:radarr-v6": "RADARR_BASE_URL=\"${RADARR_V6_BASE_URL:-http://127.0.0.1:17878}\" RADARR_API_KEY=\"${RADARR_V6_API_KEY:-e2etestapikey0123456789abcdef012}\" RADARR_EXPECTED_MAJOR=6 vitest run --config vitest.arr-e2e.radarr.config.ts",
    "test:e2e:arr:radarr-v7": "RADARR_BASE_URL=\"${RADARR_V7_BASE_URL:-http://127.0.0.1:17880}\" RADARR_API_KEY=\"${RADARR_V7_API_KEY:-e2etestapikey0123456789abcdef012}\" RADARR_EXPECTED_MAJOR=7 vitest run --config vitest.arr-e2e.radarr.config.ts",
    "typecheck": "tsc --noEmit",
    "release": "release-it"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "17.4.2",
    "fast-glob": "3.3.3",
    "ky": "2.1.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "simple-git": "3.36.0",
    "tsx": "4.23.13",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@hyrious/esbuild-plugin-commonjs": "0.2.6",
    "@playwright/test": "1.62.1",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "release-it": "21.0.2",
    "swagger-typescript-api": "13.12.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
