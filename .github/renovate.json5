{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>blackdark/renovate-base//default.json5",
    // Override base schedule:weekly — configarr bumps are intentionally rare.
    "schedule:monthly",
    // best-practices sets lockFileMaintenance weekly; schedule:monthly does not override it.
    ":maintainLockFilesMonthly",
    ":pinVersions",
    "security:minimumReleaseAgeNpm",
  ],
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**",
    // `tests/**` is not ignored: tests/arr-e2e/docker-compose.yml pins the *arr images the
    // live e2e suite runs against, and those need updates like any other dependency.
  ],
  packageRules: [
    {
      // Base maps dependencies → refactor, which would land in the release changelog.
      matchDepTypes: ["dependencies"],
      semanticCommitType: "chore",
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin"],
      automerge: true,
      addLabels: ["automerge"],
    },
    {
      matchPackageNames: ["swagger-typescript-api"],
      groupName: null,
    },
    {
      extends: ["monorepo:docusaurus"],
      groupName: "docusaurus monorepo",
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    {
      // hotio tags are `v<branch>-<app version>[-release.<build>]`, e.g. v3-3.5.0-release.1585
      // (older ones: v3-3.0.0.695). Default docker versioning treats everything after the
      // first dash as a compatibility suffix and never bumps them. `compatibility` keeps the
      // branch, so a v3 pin never jumps to v2 and vice versa.
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/hotio/**"],
      versioning: "regex:^v(?<compatibility>\\d+)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:(?:\\.|-release\\.)(?<build>\\d+))?$",
    },
    {
      // Readarr has no stable release, so it is pinned to a LinuxServer develop tag such as
      // develop-0.4.3.2665-ls130. Matching only `develop-` keeps it on that branch.
      matchDatasources: ["docker"],
      matchPackageNames: ["lscr.io/linuxserver/readarr"],
      versioning: "regex:^develop-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$",
    },
    {
      // Lidarr stays on the floating `nightly` tag: protocol items[] (#481) are not in a
      // release yet. Base/best-practices enables pinDigests; keep nightly unpinned so e2e
      // picks up new builds without waiting for a digest PR.
      matchDatasources: ["docker"],
      matchPackageNames: ["lscr.io/linuxserver/lidarr"],
      pinDigests: false,
    },
  ],
}
